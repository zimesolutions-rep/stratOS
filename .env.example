# Neon: Project dashboard > Connect. Use the pooled string here (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: the direct (unpooled) string, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this app (sign-in links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# White-label product name shown in the shell, emails and page titles
NEXT_PUBLIC_PRODUCT_NAME=StratOS

# Email sender for sign-in links: resend (default) or console (logs instead of sending)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=StratOS <hello@zimesolutions.com>

# Default country calling code for phone numbers typed without one (E.164 normalisation)
DEFAULT_COUNTRY_CODE=91

# Vercel Cron sends this as a bearer token to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=

# Meta Lead Ads (Facebook and Instagram), one app under the developer Business account for every client page.
# App secret (App settings > Basic), the verify token you type into the webhook setup, and a system-user token with
# leads_retrieval and pages_manage_metadata on the client pages.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_SYSTEM_USER_TOKEN=
# Optional: override the Graph API base, e.g. for tests
META_GRAPH_BASE_URL=

# Later steps (not used yet): EVOLUTION_*, SMS_*, TELECMI_*, GROQ_API_KEY, OPENAI_API_KEY, DEEPINFRA_API_KEY
